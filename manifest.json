{
  "manifest_version": 3,
  "name": "fansite-downloader",
  "version": "1.1.0",

  "author": "gkasse",
  "browser_specific_settings": {
    "gecko": {
      "id": "fansite_downloader@gkasse"
    }
  },

  "permissions": [
    "contextMenus",
    "notifications",
    "downloads"
  ],

  "background": {
    "scripts": [
      "src/context.js"
    ],
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://www.patreon.com/*"],
      "js": [
        "src/patreon.js"
      ]
    },
    {
      "matches": ["*://fantia.jp/*"],
      "js": [
        "src/fantia.js"
      ]
    },
    {
      "matches": [
        "*://www.fanbox.cc/*",
        "*://*.fanbox.cc/*"
      ],
      "js": [
        "src/fanbox.js"
      ]
    },
    {
      "matches": [
        "*://ci-en.dlsite.com/creator/*"
      ],
      "js": [
        "src/ci-en.js"
      ]
    }
  ]
}
